+  for (uint8_t epnum = 1; epnum < ep_count; epnum++) {
+    const dwc2_depctl_t depctl = {.value = dwc2->epout[epnum].doepctl};
+    if (!depctl.enable || depctl.type != DEPCTL_EPTYPE_ISOCHRONOUS) continue;
