+// Incomplete-ISO-IN handling for an even interval (high speed, bInterval >= 2).
+//
+// The core raises the flag at the end of every microframe of the armed parity
+// in which no IN token came. With the host polling once per interval, that
+// includes the microframes between polls, which are not misses at all. The
+// upstream handler below treats each one as a miss and re-arms for the next
+// microframe, so it burns its retries on slots the host never polls and then
+// abandons the transfer -- continuous mic dropouts at high speed. Only a flag
+// at or after the transfer's target frame is a real miss, and a real miss means
+// the host polls in the other parity: switch to it, and give it one interval.
+static void iso_in_retry_even_interval(uint8_t rhport, uint8_t epnum, dwc2_dep_t* epin,
+                                       dwc2_depctl_t depctl, xfer_ctl_t* xfer) {
+  dwc2_regs_t* dwc2 = DWC2_REG(rhport);
+  const dwc2_dsts_t dsts = {.value = dwc2->dsts};
+  const uint16_t now = (uint16_t) (dsts.frame_number & 0x3FFFu);
+  const uint16_t past_target = (uint16_t) ((now - xfer->iso_target_frame) & 0x3FFFu);
+  if (past_target >= 0x2000u) {
+    dwc2_iso_in_stats[2]++; // before the target: the host has not polled yet
+    return;
+  }
+
+  xfer->iso_in_locked = 0;
+  if (xfer->iso_retry == 0) {
+    dwc2_iso_in_stats[4]++;
+    edpt_disable(rhport, epnum | TUSB_DIR_IN_MASK, false);
+    epin->diepctl |= DIEPCTL_USBAEP;
+    dcd_event_xfer_complete(rhport, epnum | TUSB_DIR_IN_MASK, 0, XFER_RESULT_FAILED, true);
+    return;
+  }
+  xfer->iso_retry--;
+  dwc2_iso_in_stats[3]++;
+
+  dwc2_ep_tsize_t deptsiz = {.value = 0};
+  deptsiz.xfer_size = xfer->total_len;
+  deptsiz.packet_count = tu_div_ceil(xfer->total_len, xfer->max_size);
+  epin->tsiz = deptsiz.value;
+
+  xfer->iso_in_parity ^= 1u;
+  xfer->iso_target_frame = (uint16_t) ((now + xfer->interval) & 0x3FFFu);
+  if (xfer->iso_in_parity) {
+    depctl.set_data1_iso_odd = 1;
+  } else {
+    depctl.set_data0_iso_even = 1;
+  }
+  epin->diepctl = depctl.value;
+}
